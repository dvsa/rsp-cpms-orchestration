{
  "name": "rsp-cpms-orchestration",
  "version": "4.1.0",
  "description": "Service to orchestrate payment information with CPMS",
  "repository": "github.com/dvsa/rsp-cpms-orchestration",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "build-openapi": "mkdir -p build && (cd serverless && ../node_modules/.bin/sls openapi generate -f json -o ../build/openapi.json) && node openapiReplace.js",
    "openapireplace": "node openapiReplace.js",
    "test": "node --no-experimental-detect-module ./node_modules/mocha/bin/mocha.js --require ./src/test/setup.unit.cjs --require @babel/register \"src/**/*.unit.js\"",
    "test:coverage": "BABEL_ENV=coverage nyc --instrument false --all --check-coverage --per-file --statements 95.01 --branches 95.01 --functions 95.01 --lines 95.01 npm test",
    "test:integration:local": "node integration/run.cjs",
    "test:integration:reversals": "node integration/run.cjs reversals",
    "test:integration:report": "node integration/run.cjs report",
    "test:integration:report:open": "node integration/run.cjs open",
    "test:integration:tooling": "node --test integration/tooling.test.cjs",
    "lint:integration": "./node_modules/.bin/eslint \"integration/**/*.cjs\"",
    "test-i": "./node_modules/.bin/mocha --require @babel/register src/test/**/*.serviceInt.js --timeout 10000",
    "lint": "./node_modules/.bin/eslint src",
    "lint:fix": "./node_modules/.bin/eslint src --fix",
    "watch": "./node_modules/.bin/nodemon --watch src --exec npm run build",
    "offline": "cd .webpack && node --env-file=../.env ../node_modules/serverless/bin/serverless.js offline start --noAuth --localEnvironment --host 127.0.0.1 --httpPort ${LOCAL_HTTP_PORT:-3000} --lambdaPort ${LOCAL_LAMBDA_PORT:-3002}",
    "parallel": "./node_modules/.bin/run-p watch offline",
    "build": "webpack-cli --config webpack.config.js",
    "start": "npm run build && npm run parallel",
    "start:local": "npm start",
    "check:local": "node scripts/check-local.cjs",
    "build:prod": "webpack-cli --config webpack.production.js",
    "build:ci": "npm run build:prod",
    "package": "npm run build:prod && node scripts/verify-artifacts.cjs",
    "check-js-types": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@babel/core": "^7.20.2",
    "@babel/preset-env": "^7.20.2",
    "@babel/register": "^7.18.9",
    "archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "babel-loader": "^9.1.0",
    "babel-plugin-istanbul": "^8.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.27.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "expect": "^29.3.1",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "osls": "^4.5.0",
    "serverless": "npm:osls@^4.5.0",
    "serverless-offline": "^14.8.4",
    "serverless-openapi-documenter": "^0.1.7",
    "sinon": "^14.0.2",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@dvsa/rsp-validation": "^2.0.0",
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@aws-sdk/client-secrets-manager": "^3.1163.0",
    "axios": "^1.21.0",
    "dotenv": "16.0.3"
  },
  "overrides": {
    "serverless": "$serverless",
    "joi": "^17.13.9",
    "serverless-openapi-documenter": {
      "js-yaml": "^4.3.2",
      "nanoid": "^3.3.17",
      "yaml": "^1.10.3"
    }
  }
}
